<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Zoo Questy – Support</title>
<style>
  :root {
    --bg: #fbfaf6;
    --surface: #ffffff;
    --text: #1f2a24;
    --muted: #5b6760;
    --accent: #2f6b4f;
    --accent-soft: #e6f0ea;
    --border: #dde3de;
    --warn: #8a3b12;
    --warn-soft: #fbeee4;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141a17;
      --surface: #1b231f;
      --text: #e7ece9;
      --muted: #a3b0a8;
      --accent: #7cc4a0;
      --accent-soft: #22332a;
      --border: #2c3832;
      --warn: #f2a77c;
      --warn-soft: #33241b;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }
  header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 28px 16px 20px;
  }
  .wrap { max-width: 760px; margin: 0 auto; }
  header h1 { margin: 0 0 4px; font-size: 1.6rem; }
  header p { margin: 0; color: var(--muted); }
  nav.tabs {
    position: sticky; top: 0; z-index: 2;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  nav.tabs .wrap { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 16px; }
  nav.tabs a {
    text-decoration: none; color: var(--accent);
    padding: 6px 14px; border-radius: 999px;
    background: var(--accent-soft); font-weight: 600; font-size: 0.95rem;
  }
  nav.tabs a[aria-current="page"] { background: var(--accent); color: var(--surface); }
  main { padding: 8px 16px 64px; }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 22px 22px;
    margin-top: 24px;
  }
  h2 { font-size: 1.3rem; margin: 18px 0 8px; }
  p, li { overflow-wrap: anywhere; }
  a { color: var(--accent); }
  .contact-btn {
    display: inline-block; margin: 6px 0 4px;
    background: var(--accent); color: var(--surface);
    text-decoration: none; font-weight: 600;
    padding: 10px 18px; border-radius: 8px;
  }
  .muted { color: var(--muted); }
  .emergency {
    background: var(--warn-soft);
    border-left: 4px solid var(--warn);
    border-radius: 8px;
    padding: 12px 16px;
    margin-top: 24px;
  }
  .emergency strong { color: var(--warn); }
  details {
    border-top: 1px solid var(--border);
    padding: 12px 0;
  }
  details:first-of-type { border-top: none; }
  summary {
    cursor: pointer; font-weight: 600;
    list-style: none; position: relative; padding-right: 28px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+"; position: absolute; right: 4px; top: -2px;
    font-size: 1.3rem; color: var(--accent);
  }
  details[open] summary::after { content: "–"; }
  details p, details ul { margin: 8px 0 0; }
  ul { padding-left: 1.3rem; }
  footer { text-align: center; color: var(--muted); font-size: 0.9rem; padding: 0 16px 40px; }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>Zoo Questy Support</h1>
    <p>Help with your account, challenges, and privacy</p>
  </div>
</header>

<nav class="tabs" aria-label="Pages">
